{
  "manifest_version": 3,
  "name": "OB2 Download Capture",
  "short_name": "OB2",
  "version": "0.6.0",
  "description": "Sends browser downloads (Chrome or Edge) to the OB2 download manager on this PC.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "cookies", "contextMenus", "nativeMessaging", "storage", "webRequest", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "OB2",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
