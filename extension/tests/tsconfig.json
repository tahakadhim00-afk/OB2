{
  // Tests run in Node (Jest), so they may use Node APIs; the extension source may not.
  // Module settings come from ../tsconfig.json (ESNext + Bundler); ts-jest compiles to CommonJS for Jest.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["chrome", "jest", "node"]
  },
  "include": ["../src", "."]
}
