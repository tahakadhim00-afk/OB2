<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev tool: the integration-test HTTP server on a fixed port, for manual UI and browser checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Shares test code: MD5 is a supported checksum (FR-11); test naming rules do not apply. -->
    <NoWarn>$(NoWarn);CA5351;CA2007;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\OB2.Integration.Tests\Infrastructure\TestHttpServer.cs" Link="TestHttpServer.cs" />
  </ItemGroup>

</Project>
