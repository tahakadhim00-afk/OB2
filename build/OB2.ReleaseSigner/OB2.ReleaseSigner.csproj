<Project Sdk="Microsoft.NET.Sdk">

  <!-- D-84: makes the developer's release key and signs each release's SHA256SUMS.txt.
       A build tool, never shipped: the private key it reads stays outside the repository. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OB2.ReleaseSigner</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same verification the app runs, so a release OB2 would refuse never gets uploaded. -->
    <ProjectReference Include="..\..\src\OB2.Core\OB2.Core.csproj" />
  </ItemGroup>

</Project>
