<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- The release version, shown in the app (main window) and stamped on OB2.exe and host.exe. -->
    <Version>1.1.0</Version>
    <Company>Taha Kadhim</Company>
    <Authors>Taha Kadhim</Authors>
    <Product>OB2</Product>
    <Copyright>Copyright (c) 2026 Taha Kadhim. MIT License.</Copyright>
  </PropertyGroup>
</Project>
