<Project Sdk="Microsoft.NET.Sdk">

  <!-- SQLite repositories, settings file, paths, and logging setup. No UI references. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OB2.Storage</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OB2.Core\OB2.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migration scripts ship inside the assembly so a single-file exe needs no loose .sql files. -->
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="OB2.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
