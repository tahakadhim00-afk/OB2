<Window x:Class="OB2.App.Views.MediaDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OB2.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MediaDownloadViewModel}"
        Title="{StaticResource Media_Title}"
        Icon="/Resources/ob2.ico"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="{Binding VideoTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"
                   Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding PageText}" ToolTip="{Binding PageText}" />
        <TextBlock Style="{StaticResource Hint}" Text="{Binding DurationText}" Margin="0,0,0,12"
                   Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />

        <!-- First use: get yt-dlp, Deno and ffmpeg -->
        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsNeedsTools, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource SectionHeader}" Text="{StaticResource Media_ToolsHeading}" />
            <TextBlock Text="{Binding ToolsText}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Button Content="{StaticResource Media_ToolsInstall}" Command="{Binding InstallToolsCommand}" HorizontalAlignment="Left" Padding="12,4" IsDefault="True" />
        </StackPanel>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding InstallText}" Margin="0,0,0,6" />
            <ProgressBar Value="{Binding InstallPercent, Mode=OneWay}" Maximum="100" Height="16" AutomationProperties.Name="{Binding InstallText}" />
            <TextBlock Style="{StaticResource Hint}" Text="{StaticResource Media_ToolsResume}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{StaticResource Media_Loading}" Margin="0,0,0,6" />
            <ProgressBar IsIndeterminate="True" Height="16" AutomationProperties.Name="{StaticResource Media_Loading}" />
        </StackPanel>

        <StackPanel Margin="0,4,0,0" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Hint}" Text="{StaticResource Media_FailedHint}" Margin="0,8,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Content="{StaticResource Media_UpdateYtDlp}" Command="{Binding UpdateYtDlpCommand}" Padding="12,4" IsDefault="True" />
                <Button Content="{StaticResource Media_Retry}" Command="{Binding RetryCommand}" Padding="12,4" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- The choices -->
        <Grid Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Content="{StaticResource Media_Video}" Target="{Binding ElementName=VideoBox}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="VideoBox" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Videos}" SelectedItem="{Binding SelectedVideo}"
                      IsEnabled="{Binding IsVideoEnabled}" Margin="0,2" />

            <Label Grid.Row="1" Content="{StaticResource Media_Audio}" Target="{Binding ElementName=AudioBox}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="AudioBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Audios}" SelectedItem="{Binding SelectedAudio}"
                      IsEnabled="{Binding IsAudioEnabled}" Margin="0,2" />

            <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="{StaticResource Media_AudioOnly}" IsChecked="{Binding AudioOnly}"
                      IsEnabled="{Binding IsAudioOnlyEnabled}" Margin="0,6,0,2" />

            <!-- D-74: subtitles, a download of their own -->
            <Label Grid.Row="3" Content="{StaticResource Media_Subtitles}" Target="{Binding ElementName=SubtitleBox}" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
            <ComboBox x:Name="SubtitleBox" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Subtitles}" SelectedItem="{Binding SelectedSubtitle}"
                      IsEnabled="{Binding HasSubtitles}" Margin="0,8,0,2" />
            <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{Binding SubtitleFormats}" SelectedItem="{Binding SelectedSubtitleFormat}"
                      IsEnabled="{Binding IsSubtitleChosen}" AutomationProperties.Name="{StaticResource Media_SubtitleFormat}" MinWidth="64" Margin="6,8,0,2" />

            <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Content="{StaticResource Media_SubtitlesOnly}" IsChecked="{Binding SubtitlesOnly}"
                      IsEnabled="{Binding IsSubtitleChosen}" Margin="0,6,0,2" />

            <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Text="{Binding SubtitleNameText}" Margin="0,2,0,0"
                       Visibility="{Binding IsSubtitleNameVisible, Converter={StaticResource BoolToVisibility}}" />

            <Label Grid.Row="6" Content="{StaticResource Add_SaveAs}" Target="{Binding ElementName=NameBox}" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
            <TextBox x:Name="NameBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,2" />

            <Label Grid.Row="7" Content="{StaticResource Add_Folder}" Target="{Binding ElementName=FolderBox}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="FolderBox" Grid.Row="7" Grid.Column="1" Text="{Binding SaveFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
            <Button Grid.Row="7" Grid.Column="2" Content="{StaticResource Common_Browse}" Click="OnBrowse" Margin="6,2,0,2" Padding="10,0" />

            <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Text="{Binding SizeText}" Margin="0,4,0,0" />
        </Grid>

        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorText}" Margin="0,8,0,0" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{StaticResource Media_UpdateYtDlp}" Command="{Binding UpdateYtDlpCommand}" Padding="10,4"
                    Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{StaticResource Common_Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{StaticResource Add_Now}" Command="{Binding DownloadNowCommand}"
                    IsDefault="{Binding IsReady}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{StaticResource Add_Later}" Command="{Binding DownloadLaterCommand}" />
        </DockPanel>
    </StackPanel>
</Window>
