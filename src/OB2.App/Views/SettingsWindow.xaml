<Window x:Class="OB2.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OB2.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{StaticResource Settings_Title}"
        Icon="/Resources/ob2.ico"
        Width="680" Height="520" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorText}" VerticalAlignment="Center" MaxWidth="360" />
            <Button Style="{StaticResource DialogButton}" Content="{StaticResource Common_Save}" Command="{Binding SaveCommand}" IsDefault="True" />
            <Button Style="{StaticResource DialogButton}" Content="{StaticResource Common_Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>

        <TabControl x:Name="Tabs">
            <TabItem Header="{StaticResource Settings_General}">
                <StackPanel Margin="12">
                    <Label Content="{StaticResource Settings_DefaultFolder}" Target="{Binding ElementName=FolderBox}" Padding="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Text="{Binding DefaultFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="{StaticResource Common_Browse}" Click="OnBrowseDefault" Margin="6,0,0,0" Padding="10,2" />
                    </Grid>
                    <CheckBox Content="{StaticResource Settings_MinimizeToTray}" IsChecked="{Binding MinimizeToTray}" Margin="0,4" />
                    <CheckBox Content="{StaticResource Settings_ShowComplete}" IsChecked="{Binding ShowCompleteDialog}" Margin="0,4" />
                    <CheckBox Content="{StaticResource Settings_Notifications}" IsChecked="{Binding ShowNotifications}" Margin="0,4" />
                    <CheckBox Content="{StaticResource Settings_AutoResume}" IsChecked="{Binding AutoResume}" Margin="0,4" />
                    <CheckBox Content="{StaticResource Settings_StartWithWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,4" />
                    <CheckBox Content="{StaticResource Settings_RememberAuth}" IsChecked="{Binding RememberAuth}" Margin="0,4" ToolTip="{StaticResource Settings_RememberAuthTip}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{StaticResource Settings_Connection}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="{StaticResource Settings_Connections}" Target="{Binding ElementName=C1}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="C1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding Connections, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                    <Label Grid.Row="1" Content="{StaticResource Settings_PerHost}" Target="{Binding ElementName=C2}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="C2" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding MaxPerHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                    <Label Grid.Row="2" Content="{StaticResource Settings_Retries}" Target="{Binding ElementName=C3}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="C3" Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding Retries, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                    <Label Grid.Row="3" Content="{StaticResource Settings_ConnectTimeout}" Target="{Binding ElementName=C4}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="C4" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding ConnectTimeout, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                    <Label Grid.Row="4" Content="{StaticResource Settings_ReadTimeout}" Target="{Binding ElementName=C5}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="C5" Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding ReadTimeout, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                    <Label Grid.Row="5" Content="{StaticResource Settings_GlobalLimit}" Target="{Binding ElementName=C6}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="C6" Grid.Row="5" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding GlobalLimitKBps, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                    <Label Grid.Row="6" Content="{StaticResource Settings_UserAgent}" Target="{Binding ElementName=C7}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                    <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,3">
                        <Button DockPanel.Dock="Right" Content="{StaticResource Settings_ResetUserAgent}" Command="{Binding ResetUserAgentCommand}" Margin="6,0,0,0" Padding="10,2" VerticalAlignment="Top" />
                        <TextBox x:Name="C7" Text="{Binding UserAgent, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="54" VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{StaticResource Browser_Tab}">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{StaticResource Browser_Integration}" />
                    <TextBlock Text="{Binding BrowserStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{StaticResource Browser_Register}" Command="{Binding RegisterBrowserCommand}" Padding="12,2" />
                        <Button Content="{StaticResource Browser_Unregister}" Command="{Binding UnregisterBrowserCommand}" Padding="12,2" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{StaticResource Browser_Help}" Margin="0,0,0,16" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{StaticResource Browser_Rules}" />
                    <CheckBox Content="{StaticResource Browser_Confirm}" IsChecked="{Binding ConfirmCapture}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Content="{StaticResource Browser_MinSize}" Target="{Binding ElementName=B1}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="B1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding CaptureMinSizeMb, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                        <Label Grid.Row="1" Content="{StaticResource Browser_Extensions}" Target="{Binding ElementName=B2}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="B2" Grid.Row="1" Grid.Column="1" Text="{Binding CaptureExtensions, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,3" />
                        <Label Grid.Row="2" Content="{StaticResource Browser_Excluded}" Target="{Binding ElementName=B3}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="B3" Grid.Row="2" Grid.Column="1" Text="{Binding ExcludedDomains, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="{StaticResource Settings_Categories}">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{StaticResource Common_Add}" Command="{Binding AddCategoryCommand}" Padding="12,2" />
                        <Button Content="{StaticResource Common_Remove}" Command="{Binding RemoveCategoryCommand}" Padding="12,2" Margin="6,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" IsReadOnly="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{StaticResource Settings_CategoryName}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                            <DataGridTextColumn Header="{StaticResource Settings_CategoryExtensions}" Binding="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridTextColumn Header="{StaticResource Settings_CategoryFolder}" Binding="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
