<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF desktop app and DI composition root. UI only: no network I/O or file writes here (PRD §7.2). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OB2.App</RootNamespace>
    <AssemblyName>OB2</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OB2.Core\OB2.Core.csproj" />
    <ProjectReference Include="..\OB2.Shared\OB2.Shared.csproj" />
    <ProjectReference Include="..\OB2.Storage\OB2.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
