<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF desktop app and DI composition root. UI only: no network I/O or file writes here (PRD §7.2). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OB2.App</RootNamespace>
    <AssemblyName>OB2</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>OB2.App.Program</StartupObject>
    <ApplicationIcon>Resources\ob2.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OB2.Core\OB2.Core.csproj" />
    <ProjectReference Include="..\OB2.Shared\OB2.Shared.csproj" />
    <ProjectReference Include="..\OB2.Storage\OB2.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\ob2.ico" />
    <!-- The OB2 wordmark, used straight from the logo artwork so there is one copy. -->
    <Resource Include="..\..\assets\logo\inside_app_logo.png" Link="Resources\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
