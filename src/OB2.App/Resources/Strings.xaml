    <sys:String x:Key="Status_Queued">Queued</sys:String>
    <sys:String x:Key="Status_Probing">Connecting…</sys:String>
    <sys:String x:Key="Status_Downloading">Downloading</sys:String>
    <sys:String x:Key="Status_Paused">Paused</sys:String>
