    <sys:String x:Key="Col_Size">Size</sys:String>
    <sys:String x:Key="Col_Status">Status</sys:String>
    <sys:String x:Key="Col_Progress">Progress</sys:String>
    <sys:String x:Key="Col_Speed">Speed</sys:String>
    <sys:String x:Key="Col_TimeLeft">Time left</sys:String>
