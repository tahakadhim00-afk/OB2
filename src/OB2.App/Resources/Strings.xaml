    <sys:String x:Key="Menu_DownloadLater">Put back in queue</sys:String>
    <sys:String x:Key="Menu_MoveToQueue">Move to queue</sys:String>

    <!-- Details panel -->
    <sys:String x:Key="Detail_Url">Address</sys:String>
    <sys:String x:Key="Detail_Destination">Saved to</sys:String>
    <sys:String x:Key="Detail_Error">Error</sys:String>
    <sys:String x:Key="Detail_Connections">Connections</sys:String>
    <sys:String x:Key="Detail_Retry">Retry</sys:String>
