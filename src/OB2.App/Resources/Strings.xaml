    <sys:String x:Key="Tb_StopQueue">Stop Queue</sys:String>
    <sys:String x:Key="Tb_Add_Tip">Add a download by address (Ctrl+N)</sys:String>
    <sys:String x:Key="Tb_Resume_Tip">Start or resume the selected downloads (Space)</sys:String>
    <sys:String x:Key="Tb_Stop_Tip">Pause the selected downloads (Space)</sys:String>
    <sys:String x:Key="Tb_StopAll_Tip">Pause every download (Ctrl+Shift+P)</sys:String>
    <sys:String x:Key="Tb_Delete_Tip">Remove the selected downloads (Del)</sys:String>

