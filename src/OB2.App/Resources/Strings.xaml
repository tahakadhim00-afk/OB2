    <sys:String x:Key="Common_Add">Add</sys:String>
    <sys:String x:Key="Common_Remove">Remove</sys:String>
    <sys:String x:Key="Common_Unknown">Unknown</sys:String>

    <!-- Toolbar (§9.1) -->
    <sys:String x:Key="Tb_Add">Add URL</sys:String>
    <sys:String x:Key="Tb_Resume">Resume</sys:String>
    <sys:String x:Key="Tb_Stop">Stop</sys:String>
    <sys:String x:Key="Tb_StopAll">Stop All</sys:String>
    <sys:String x:Key="Tb_ResumeAll">Resume All</sys:String>
    <sys:String x:Key="Tb_Delete">Delete</sys:String>
    <sys:String x:Key="Tb_Options">Options</sys:String>
    <sys:String x:Key="Tb_Scheduler">Scheduler</sys:String>
