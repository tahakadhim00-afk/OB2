    <sys:String x:Key="Scheduler_Title">Scheduler</sys:String>
    <sys:String x:Key="Scheduler_Queues">Queues</sys:String>
    <sys:String x:Key="Scheduler_NewQueue">New queue</sys:String>
    <sys:String x:Key="Scheduler_Name">Name</sys:String>
    <sys:String x:Key="Scheduler_Concurrency">Downloads at the same time</sys:String>
