    <sys:String x:Key="Exec_Message">"{0}" is a program or script downloaded from the internet. Open it only if you trust where it came from. Open it now?</sys:String>

    <!-- Notifications (FR-27) and tray (§9.4) -->
    <sys:String x:Key="Notify_Completed">Download complete</sys:String>
    <sys:String x:Key="Notify_Failed">Download failed</sys:String>
    <sys:String x:Key="Notify_QueueDone">Queue "{0}" finished</sys:String>
