    <sys:String x:Key="Settings_DefaultFolder">Default save folder</sys:String>
    <sys:String x:Key="Settings_MinimizeToTray">Closing the window keeps OB2 running in the tray</sys:String>
    <sys:String x:Key="Settings_ShowComplete">Show the "Download complete" window</sys:String>
    <sys:String x:Key="Settings_Notifications">Show Windows notifications for finished and failed downloads</sys:String>
