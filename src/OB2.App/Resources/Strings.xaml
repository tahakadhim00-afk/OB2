    <sys:String x:Key="Scheduler_UseStop">Stop at a set time</sys:String>
    <sys:String x:Key="Scheduler_Days">On these days</sys:String>
    <sys:String x:Key="Scheduler_WhenDone">When the queue finishes</sys:String>
