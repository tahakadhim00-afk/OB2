    <sys:String x:Key="Add_Credentials">This address contains a user name and password. Download it anyway?</sys:String>
    <sys:String x:Key="Add_FromBrowser">Captured from {0}</sys:String>

    <!-- Download complete (§9.3) -->
    <sys:String x:Key="Complete_Title">Download complete</sys:String>
    <sys:String x:Key="Complete_Size">Size: {0}</sys:String>
    <sys:String x:Key="Complete_Time">Time taken: {0}</sys:String>
    <sys:String x:Key="Complete_OpenFile">Open File</sys:String>
    <sys:String x:Key="Complete_OpenFolder">Open Folder</sys:String>
    <sys:String x:Key="Complete_DontShow">Do not show again for this category</sys:String>
