<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- All user-visible text lives here so it can be translated later (NFR Localization). -->
    <sys:String x:Key="App_Title">OB2</sys:String>
    <sys:String x:Key="Shell_Empty">No downloads yet.</sys:String>
    <sys:String x:Key="Status_DataRoot">Data folder: {0}</sys:String>
    <sys:String x:Key="Status_Portable">Portable</sys:String>
    <sys:String x:Key="Status_PerUser">Installed (per user)</sys:String>
    <sys:String x:Key="Status_Schema">Database schema v{0}</sys:String>
    <sys:String x:Key="Startup_FailedTitle">OB2 could not start</sys:String>
    <sys:String x:Key="Startup_FailedMessage">OB2 could not prepare its data folder or database.&#x0a;&#x0a;{0}</sys:String>
    <sys:String x:Key="Error_UnexpectedTitle">Something went wrong</sys:String>
    <sys:String x:Key="Error_UnexpectedMessage">OB2 hit an unexpected error and recovered. Details were written to the log file.&#x0a;&#x0a;{0}</sys:String>
</ResourceDictionary>
